{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 460,
  "padding": {
    "left": 8,
    "right": 18,
    "top": 6,
    "bottom": 8
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "data": {
    "url": "data/ica_bushfire_cleaned.json"
  },
  "transform": [
    {
      "calculate": "datum.severity_category === 'Low' || datum.severity_category === 'Medium' ? 'Medium' : datum.severity_category",
      "as": "severity_category"
    }
  ],
  "params": [
    {
      "name": "select_severity",
      "value": "All"
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "background": "#FFFDF9",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Outfit",
      "labelColor": "#5F6B7A",
      "titleColor": "#3A332E",
      "domainColor": "rgba(43, 38, 33, 0.25)",
      "tickColor": "rgba(43, 38, 33, 0.25)",
      "gridColor": "rgba(43, 38, 33, 0.10)",
      "gridOpacity": 1,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 700
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover_bubble",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "nearest": false,
            "fields": ["year", "loss_billion", "severity_category"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "transparent",
        "strokeWidth": 0.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year of Disaster",
          "scale": {
            "zero": false,
            "domain": [1965, 2028]
          },
          "axis": {
            "format": "d",
            "grid": true,
            "titlePadding": 10,
            "tickCount": 10
          }
        },
        "y": {
          "field": "loss_billion",
          "type": "quantitative",
          "title": "Normalised insured loss, 2022 $B",
          "scale": {
            "domain": [-0.125, 4.5],
            "nice": false
          },
          "axis": {
            "labelExpr": "'$' + datum.value + 'B'",
            "values": [0, 1, 2, 3, 4],
            "grid": true,
            "titlePadding": 10
          }
        },
        "size": {
          "field": "bubble_size_metric",
          "type": "quantitative",
          "scale": {
            "domain": [1000, 60000],
            "range": [80, 850]
          },
          "legend": null
        },
        "color": {
          "field": "severity_category",
          "type": "nominal",
          "scale": {
            "domain": ["Medium", "High", "Catastrophic"],
            "range": ["#ffeda0", "#feb24c", "#f03b20"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "event_name",
            "type": "nominal",
            "title": "Catastrophe Event"
          },
          { "field": "year", "type": "quantitative", "title": "Year" },
          {
            "field": "loss_billion_label",
            "type": "nominal",
            "title": "Normalised Insured Loss"
          },
          {
            "field": "original_loss_label",
            "type": "nominal",
            "title": "Original Insured Loss"
          },
          {
            "field": "claims_label",
            "type": "nominal",
            "title": "Total Claims Received"
          },
          {
            "field": "severity_category",
            "type": "nominal",
            "title": "Severity Category"
          }
        ],
        "opacity": {
          "condition": [
            {
              "test": "select_severity !== 'All' && datum.severity_category !== select_severity",
              "value": 0.05
            },
            {
              "param": "hover_bubble",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_label",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": 1.0
            },
            {
              "test": "length(data('hover_bubble_store')) === 0 && length(data('hover_label_store')) === 0 && length(data('hover_note_store')) === 0",
              "value": 1.0
            }
          ],
          "value": 0.15
        },
        "stroke": {
          "condition": [
            {
              "param": "hover_bubble",
              "empty": false,
              "value": "#1F1F1F"
            },
            {
              "param": "hover_label",
              "empty": false,
              "value": "#1F1F1F"
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": "#1F1F1F"
            }
          ],
          "value": "transparent"
        },
        "strokeWidth": {
          "condition": [
            {
              "param": "hover_bubble",
              "empty": false,
              "value": 1.5
            },
            {
              "param": "hover_label",
              "empty": false,
              "value": 1.5
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": 1.5
            }
          ],
          "value": 0.5
        }
      }
    },
    {
      "transform": [{ "filter": "datum.is_black_summer === true" }],
      "mark": {
        "type": "point",
        "shape": "circle",
        "stroke": "#1F1F1F",
        "strokeWidth": 2,
        "fill": "#f03b20"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "domain": [1965, 2028]
          }
        },
        "y": {
          "field": "loss_billion",
          "type": "quantitative",
          "scale": {
            "domain": [-0.125, 4.5],
            "nice": false
          }
        },
        "size": {
          "field": "bubble_size_metric",
          "type": "quantitative",
          "scale": {
            "domain": [1000, 60000],
            "range": [80, 850]
          }
        },
        "opacity": {
          "condition": [
            {
              "test": "select_severity !== 'All' && select_severity !== 'Catastrophic'",
              "value": 0.05
            },
            {
              "param": "hover_bubble",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_label",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": 1.0
            },
            {
              "test": "length(data('hover_bubble_store')) > 0 || length(data('hover_label_store')) > 0 || length(data('hover_note_store')) > 0",
              "value": 0.15
            }
          ],
          "value": 1.0
        }
      }
    },
    {
      "params": [
        {
          "name": "hover_label",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": ["year", "loss_billion", "severity_category"]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "fill": "#2B2621",
        "cursor": "pointer",
        "dx": {
          "expr": "datum.year === 2019 ? 14 : datum.label_dx"
        },
        "dy": {
          "expr": "datum.year === 2019 ? -16 : datum.label_dy"
        },
        "align": {
          "expr": "datum.year === 2019 ? 'left' : datum.label_align"
        }
      },
      "transform": [
        {
          "calculate": "datum.year === 1967 ? '1967 Bushfire' : datum.event_name === 'Ash Wednesday Bushfire (VIC)' ? 'Ash Wednesday' : datum.event_name === 'Black Saturday Bushfire' ? 'Black Saturday' : datum.event_name === '2019/20 Bushfires (NSW,QLD,SA,VIC)' ? 'Black Summer' : datum.event_name === 'Canberra Bushfire' ? 'Canberra Bushfire' : datum.event_name",
          "as": "short_label"
        }
      ],
      "encoding": {
        "opacity": {
          "condition": [
            {
              "test": "select_severity !== 'All' && datum.severity_category !== select_severity",
              "value": 0.0
            },
            {
              "test": "datum.is_top_event === true && length(data('hover_bubble_store')) === 0 && length(data('hover_label_store')) === 0 && length(data('hover_note_store')) === 0",
              "value": 1.0
            },
            {
              "param": "hover_bubble",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_label",
              "empty": false,
              "value": 1.0
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": 1.0
            },
            {
              "test": "datum.is_top_event === true && (length(data('hover_bubble_store')) > 0 || length(data('hover_label_store')) > 0 || length(data('hover_note_store')) > 0)",
              "value": 0.15
            }
          ],
          "value": 0.0
        },
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "domain": [1965, 2028]
          }
        },
        "y": {
          "field": "loss_billion",
          "type": "quantitative",
          "scale": {
            "domain": [-0.125, 4.5],
            "nice": false
          }
        },
        "text": {
          "condition": {
            "test": "datum.is_top_event === true",
            "field": "short_label",
            "type": "nominal"
          },
          "value": ""
        },
        "tooltip": [
          {
            "field": "event_name",
            "type": "nominal",
            "title": "Catastrophe Event"
          },
          { "field": "year", "type": "quantitative", "title": "Year" },
          {
            "field": "loss_billion_label",
            "type": "nominal",
            "title": "Normalised Insured Loss"
          },
          {
            "field": "original_loss_label",
            "type": "nominal",
            "title": "Original Insured Loss"
          },
          {
            "field": "claims_label",
            "type": "nominal",
            "title": "Total Claims Received"
          },
          {
            "field": "severity_category",
            "type": "nominal",
            "title": "Severity Category"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1967,
            "event_name": "Bushfire",
            "loss_billion": 4.1036,
            "loss_billion_label": "$4.10B",
            "original_loss_label": "$40,000,000",
            "claims_label": "No claims data",
            "severity_category": "Catastrophic",
            "y": 4.1,
            "text": "Largest normalised insured loss in the dataset"
          },
          {
            "year": 2019,
            "event_name": "2019/20 Bushfires (NSW,QLD,SA,VIC)",
            "loss_billion": 2.4054,
            "loss_billion_label": "$2.41B",
            "original_loss_label": "$2,319,164,486",
            "claims_label": "38,936",
            "severity_category": "Catastrophic",
            "y": 2.41,
            "text": "Major recent insured-loss shock"
          }
        ]
      },
      "params": [
        {
          "name": "hover_note",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": ["year", "loss_billion", "severity_category"]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9,
        "fontStyle": "italic",
        "fontWeight": 500,
        "dx": {
          "expr": "datum.year === 1967 ? 12 : (datum.year === 2019 ? 16 : 12)"
        },
        "dy": {
          "expr": "datum.year === 1967 ? 12 : (datum.year === 2019 ? 16 : 6)"
        },
        "align": {
          "expr": "datum.year === 1967 ? 'left' : 'left'"
        },
        "cursor": "pointer",
        "stroke": "#ffffff",
        "strokeOpacity": 0,
        "strokeWidth": 8
      },
      "encoding": {
        "fill": {
          "condition": {
            "param": "hover_note",
            "empty": false,
            "value": "#bd0026"
          },
          "value": "#8f241c"
        },
        "opacity": {
          "condition": [
            {
              "test": "select_severity !== 'All' && select_severity !== 'Catastrophic'",
              "value": 0.0
            },
            {
              "param": "hover_note",
              "empty": false,
              "value": 1
            },
            {
              "test": "(hover_bubble && isDefined(hover_bubble.severity_category) && hover_bubble.severity_category !== 'Catastrophic') || (hover_label && isDefined(hover_label.severity_category) && hover_label.severity_category !== 'Catastrophic') || (hover_note && isDefined(hover_note.severity_category) && hover_note.severity_category !== 'Catastrophic')",
              "value": 0.1
            }
          ],
          "value": 1
        },
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "domain": [1965, 2028]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [-0.125, 4.5],
            "nice": false
          }
        },
        "text": {
          "field": "text",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "event_name",
            "type": "nominal",
            "title": "Catastrophe Event"
          },
          { "field": "year", "type": "quantitative", "title": "Year" },
          {
            "field": "loss_billion_label",
            "type": "nominal",
            "title": "Normalised Insured Loss"
          },
          {
            "field": "original_loss_label",
            "type": "nominal",
            "title": "Original Insured Loss"
          },
          {
            "field": "claims_label",
            "type": "nominal",
            "title": "Total Claims Received"
          },
          {
            "field": "severity_category",
            "type": "nominal",
            "title": "Severity Category"
          }
        ]
      }
    }
  ]
}
