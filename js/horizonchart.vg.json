{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/australian_annual_bushfire_area_(19902020).csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "fold": [
        "Tropical_savanna_woodlands",
        "Arid_semi_arid_rangelands",
        "Temperate_forest_wildfires",
        "Temperate_forest_hazard_reduction"
      ],
      "as": ["Category", "Area"]
    },
    {"calculate": "toNumber(datum.Area)", "as": "Area"},
    {"calculate": "toNumber(datum.Year)", "as": "Year"},
    {
      "calculate": "datum.Category === 'Tropical_savanna_woodlands' ? 'Tropical Savanna Woodlands' : datum.Category === 'Arid_semi_arid_rangelands' ? 'Arid & Semi-Arid Rangelands' : datum.Category === 'Temperate_forest_wildfires' ? 'Temperate Forest Wildfires' : 'Hazard Reduction Burns'",
      "as": "Fire Type"
    },
    {
      "calculate": "datum.Category === 'Hazard_reduction' ? 1 : datum.Category === 'Temperate_forest_wildfires' ? 2 : datum.Category === 'Arid_semi_arid_rangelands' ? 3 : datum.Category === 'Tropical_savanna_woodlands' ? 4 : datum.Category === 'Temperate_forest_hazard_reduction' ? 1 : 4",
      "as": "stackOrder"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "highlight",
          "select": {
            "type": "point",
            "fields": ["Fire Type"],
            "on": "pointerover"
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "line": {
          "color": "white",
          "strokeWidth": 0.8
        },
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {"zero": false, "nice": false},
          "axis": {
            "title": null,
            "format": "d",
            "grid": false,
            "tickCount": 8,
            "labelFont": "Inter",
            "labelFontSize": 11,
            "labelColor": "#555",
            "domainColor": "#bbb"
          }
        },
        "y": {
          "field": "Area",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "Fire Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Tropical Savanna Woodlands",
              "Arid & Semi-Arid Rangelands",
              "Temperate Forest Wildfires",
              "Hazard Reduction Burns"
            ],
            "range": ["#388e3c", "#8d6e63", "#c62828", "#ff8f00"]
          },
          "legend": {
            "title": "Vegetation Type",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelFont": "Inter",
            "labelFontSize": 11,
            "labelColor": "#444",
            "titleFont": "Outfit",
            "titleFontSize": 12,
            "titleColor": "#333",
            "symbolType": "circle",
            "symbolSize": 100,
            "symbolStrokeWidth": 0,
            "padding": 10,
            "offset": 8
          }
        },
        "order": {
          "field": "stackOrder",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {"param": "highlight", "value": 0.95},
          "value": 0.7
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "Fire Type", "type": "nominal", "title": "Vegetation Type"},
          {"field": "Area", "type": "quantitative", "title": "Area (M ha)", "format": ".0f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Year": 2015, "label": "Peak Year"},
          {"Year": 2002, "label": "Drought Dip"},
          {"Year": 2009, "label": "Black Saturday"}
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 3],
        "strokeWidth": 1.2,
        "opacity": 0.5
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "color": {"value": "#555"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": 2015, "label": "Peak: 60M ha burned", "yPos": -30},
          {"Year": 2002, "label": "Drought dip", "yPos": -30},
          {"Year": 2009, "label": "Black Saturday", "yPos": 30}
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "opacity": 0.75,
        "align": "center",
        "baseline": "bottom",
        "dy": -4
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "yPos", "type": "quantitative", "scale": {"domain": [-30, 30]}},
        "text": {"field": "label"},
        "color": {"value": "#333"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": 1993, "label": "↑ Savanna burning dominates", "yPos": -28},
          {"Year": 2007, "label": "↓ Rangelands overtake wildfires", "yPos": 28}
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9.5,
        "fontStyle": "italic",
        "opacity": 0.65,
        "align": "left",
        "baseline": "middle"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "yPos", "type": "quantitative", "scale": {"domain": [-30, 30]}},
        "text": {"field": "label"},
        "color": {"value": "#2e7d32"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "transparent",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "title": {
      "font": "Outfit",
      "subtitleFont": "Inter"
    }
  }
}
