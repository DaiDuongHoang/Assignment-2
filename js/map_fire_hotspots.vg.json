{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 415,
  "projection": {
    "type": "mercator",
    "center": { "expr": "center_to" },
    "scale": { "expr": "zoom_level" }
  },
  "params": [
    {
      "name": "Day_selection",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 31,
        "step": 1,
        "name": "Day: "
      }
    },
    {
      "name": "zoom_level",
      "value": 600,
      "bind": {
        "input": "range",
        "min": 600,
        "max": 5000,
        "step": 50,
        "name": "Map Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [134, -28.5],
      "bind": {
        "input": "select",
        "options": [
          [134, -28.5],
          [147, -37],
          [120, -32],
          [134, -17]
        ],
        "labels": [
          "Whole Australia",
          "Southeast Region (Black Summer)",
          "Southwest Region (Wheatbelt)",
          "Northern Region (Savanna Burns)"
        ],
        "name": "Map Centre: "
      }
    },
    {
      "name": "zoom_region_region",
      "value": null
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/Map base.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dce0e5",
        "stroke": "#7a7a7a",
        "strokeWidth": 0.4,
        "strokeOpacity": 0.6
      }
    },
    {
      "data": {
        "url": "data/Fire.csv"
      },
      "transform": [
        {
          "filter": "parseInt(slice(datum.acq_date, 8, 10)) === Day_selection"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.4,
        "stroke": "white",
        "strokeWidth": 0.1,
        "strokeOpacity": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "frp",
          "type": "quantitative",
          "title": "Fire Radiative Power (MW)",
          "scale": {
            "domain": [0, 500],
            "range": [1, 30]
          },
          "legend": null
        },
        "color": {
          "field": "brightness",
          "type": "quantitative",
          "title": "Brightness Temperature (K)",
          "scale": {
            "scheme": "yelloworangered",
            "domain": [300, 500]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Latitude:",
            "format": ".3f"
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Longitude:",
            "format": ".3f"
          },
          {
            "field": "brightness",
            "type": "quantitative",
            "title": "Brightness (K):"
          },
          {
            "field": "frp",
            "type": "quantitative",
            "title": "Fire Power (MW):"
          },
          {
            "field": "acq_date",
            "type": "nominal",
            "title": "Date:"
          },
          {
            "field": "confidence",
            "type": "quantitative",
            "title": "Confidence (%):"
          },
          {
            "field": "satellite",
            "type": "nominal",
            "title": "Satellite:"
          },
          {
            "field": "daynight",
            "type": "nominal",
            "title": "Day/Night:"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "lat": -33.8688,
            "lon": 151.2093
          },
          {
            "city": "Melbourne",
            "lat": -37.8136,
            "lon": 144.9631
          },
          {
            "city": "Brisbane",
            "lat": -27.4705,
            "lon": 153.026
          },
          {
            "city": "Perth",
            "lat": -31.9505,
            "lon": 115.8605
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "diamond",
            "size": 50,
            "fill": "#1a1a1a",
            "stroke": "#ffffff",
            "strokeWidth": 1.0
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 700,
            "dy": -10,
            "dx": 13,
            "xOffset": 2,
            "align": "right",
            "fill": "#2f2f2f",
            "opacity": 0.85
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "area": "Black Summer",
            "lon": 141,
            "lat": -40,
            "lon2": 148.7,
            "lat2": -36.5,
            "region": "Southeast"
          },
          {
            "area": "Wheatbelt",
            "lon": 124.0,
            "lat": -36,
            "lon2": 123,
            "lat2": -33.0,
            "region": "Southwest"
          },
          {
            "area": "Top End west",
            "lon": 150.7,
            "lat": -15,
            "lon2": 144,
            "lat2": -20.0,
            "region": "North"
          },
          {
            "area": "Top End centre",
            "lon": 150.7,
            "lat": -15,
            "lon2": 143.5,
            "lat2": -14.5,
            "region": "North"
          },
          {
            "area": "Top End east",
            "lon": 150.7,
            "lat": -15,
            "lon2": 145,
            "lat2": -18,
            "region": "North"
          }
        ]
      },
      "layer": [
        {
          "params": [
            {
              "name": "zoom_region",
              "select": {
                "type": "point",
                "fields": ["region"],
                "on": "click"
              }
            }
          ],
          "mark": {
            "type": "rule",
            "opacity": 0.85,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat2"
            },
            "color": {
              "condition": {
                "test": "zoom_region_region === datum.region",
                "value": "#d32f2f"
              },
              "value": "#b71c1c"
            },
            "size": {
              "condition": {
                "test": "zoom_region_region === datum.region",
                "value": 2.5
              },
              "value": 1.8
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "fill": "#ffffff",
            "strokeWidth": 1.5,
            "opacity": 0.7,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "lon2",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat2",
              "type": "quantitative"
            },
            "size": {
              "condition": {
                "test": "zoom_region_region === datum.region",
                "value": 30
              },
              "value": 15
            },
            "color": {
              "condition": {
                "test": "zoom_region_region === datum.region",
                "value": "#d32f2f"
              },
              "value": "#b71c1c"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "text": "Intense Black Summer Fires (2019-20)",
            "lon": 141.2,
            "lat": -40,
            "region": "Southeast"
          },
          {
            "text": "Wheatbelt Fires (WA)",
            "lon": 130.0,
            "lat": -36.5,
            "region": "Southwest"
          },
          {
            "text": "Seasonal Savanna Burns (NT)",
            "lon": 170.0,
            "lat": -15,
            "region": "North"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        },
        "color": {
          "condition": {
            "test": "zoom_region_region === datum.region",
            "value": "#d32f2f"
          },
          "value": "#b71c1c"
        },
        "size": {
          "condition": {
            "test": "zoom_region_region === datum.region",
            "value": 16.5
          },
          "value": 13.5
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "legend": {
      "orient": "top-right",
      "fillColor": "#ffffff",
      "strokeColor": "#cccccc",
      "padding": 12,
      "cornerRadius": 5,
      "offset": 10
    }
  }
}
