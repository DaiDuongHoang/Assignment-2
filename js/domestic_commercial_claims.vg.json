{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Coordinated domestic/commercial claim composition and total claim scale for ICA bushfire records with explicit claim-type breakdowns.",
  "width": 1200,
  "height": 226,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 8,
    "right": 24,
    "bottom": 30,
    "left": 6
  },
  "signals": [
    {
      "name": "leftLabelWidth",
      "value": 205
    },
    {
      "name": "leftPlotX",
      "value": 205
    },
    {
      "name": "leftPlotWidth",
      "value": 575
    },
    {
      "name": "gap",
      "value": 28
    },
    {
      "name": "rightPlotX",
      "update": "leftPlotX + leftPlotWidth + gap"
    },
    {
      "name": "rightPlotWidth",
      "value": 330
    },
    {
      "name": "plotTop",
      "value": 70
    },
    {
      "name": "plotBottom",
      "value": 198
    },
    {
      "name": "rowHeight",
      "value": 22
    },
    {
      "name": "eventHover",
      "value": null,
      "on": [
        {
          "events": "mouseover",
          "update": "datum && datum.event_name ? datum.event_name : eventHover"
        },
        {
          "events": "mouseout",
          "update": "datum && datum.event_name ? null : eventHover"
        }
      ]
    },
    {
      "name": "claimTypeHover",
      "value": null,
      "on": [
        {
          "events": "@domesticLegendSwatch:mouseover, @domesticLegendText:mouseover",
          "update": "'Domestic'"
        },
        {
          "events": "@commercialLegendSwatch:mouseover, @commercialLegendText:mouseover",
          "update": "'Commercial'"
        },
        {
          "events": "@domesticLegendSwatch:mouseout, @domesticLegendText:mouseout, @commercialLegendSwatch:mouseout, @commercialLegendText:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "claims",
      "url": "data/domestic_commercial_bushfire_claims.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "formula",
          "as": "total_claims_text",
          "expr": "datum.total_claims_label + ' claims'"
        }
      ]
    },
    {
      "name": "shareTicks",
      "values": [
        {
          "value": -100
        },
        {
          "value": -50
        },
        {
          "value": 0
        },
        {
          "value": 50
        },
        {
          "value": 100
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "claims",
        "field": "event_name",
        "sort": {
          "op": "min",
          "field": "sort_order"
        }
      },
      "range": [
        {
          "signal": "plotTop"
        },
        {
          "signal": "plotBottom"
        }
      ],
      "paddingInner": 0.44,
      "paddingOuter": 0.18
    },
    {
      "name": "xShare",
      "type": "linear",
      "domain": [
        -100,
        100
      ],
      "range": [
        {
          "signal": "leftPlotX"
        },
        {
          "signal": "leftPlotX + leftPlotWidth"
        }
      ],
      "nice": false,
      "zero": true
    },
    {
      "name": "xClaims",
      "type": "linear",
      "domain": [
        0,
        5200
      ],
      "range": [
        {
          "signal": "rightPlotX"
        },
        {
          "signal": "rightPlotX + rightPlotWidth"
        }
      ],
      "nice": false,
      "zero": true
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "xShare",
      "title": "Share of domestic + commercial claims",
      "values": [
        -100,
        -50,
        0,
        50,
        100
      ],
      "labelColor": "#786e66",
      "labelFont": "Inter, Arial, sans-serif",
      "labelFontSize": 11,
      "titleColor": "#3A332E",
      "titleFont": "Inter, Arial, sans-serif",
      "titleFontSize": 12,
      "titlePadding": 10,
      "domainColor": "rgba(43, 38, 33, 0.25)",
      "tickColor": "rgba(43, 38, 33, 0.25)",
      "grid": false,
      "zindex": 1,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "abs(datum.value) + '%'"
            }
          }
        }
      }
    },
    {
      "orient": "bottom",
      "scale": "xClaims",
      "title": "Total claims",
      "tickCount": 4,
      "format": "~s",
      "labelColor": "#786e66",
      "labelFont": "Inter, Arial, sans-serif",
      "labelFontSize": 11,
      "titleColor": "#3A332E",
      "titleFont": "Inter, Arial, sans-serif",
      "titleFontSize": 12,
      "titlePadding": 10,
      "domainColor": "rgba(43, 38, 33, 0.25)",
      "tickColor": "rgba(43, 38, 33, 0.25)",
      "grid": false,
      "zindex": 1
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "leftPlotX"
          },
          "y": {
            "value": 14
          },
          "text": {
            "value": "Claim composition"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 800
          },
          "fill": {
            "value": "#2B2621"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "rightPlotX"
          },
          "y": {
            "value": 14
          },
          "text": {
            "value": "Total claims"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 800
          },
          "fill": {
            "value": "#2B2621"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    },

    {
      "type": "rule",
      "from": {
        "data": "shareTicks"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "field": "value"
          },
          "y": {
            "signal": "plotTop - 4"
          },
          "y2": {
            "signal": "plotBottom + 4"
          },
          "stroke": {
            "value": "#f3ede6"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "opacity": {
            "signal": "datum.value === 0 ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "value": 0
          },
          "y": {
            "signal": "plotTop - 8"
          },
          "y2": {
            "signal": "plotBottom + 8"
          },
          "stroke": {
            "value": "#2c333a"
          },
          "strokeWidth": {
            "value": 1.35
          },
          "opacity": {
            "value": 0.88
          }
        }
      }
    },
    {
      "type": "text",
      "name": "eventLabels",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftPlotX - 12"
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "text": {
            "field": "event_name"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "limit": {
            "value": 190
          }
        },
        "update": {
          "fill": {
            "signal": "eventHover === datum.event_name ? '#111827' : '#1b2330'"
          },
          "fontWeight": {
            "signal": "eventHover === datum.event_name ? 800 : 700"
          },
          "opacity": {
            "signal": "eventHover === null || eventHover === datum.event_name ? 1 : 0.46"
          },
          "tooltip": {
            "signal": "{'Event:': datum.event_name, 'Year:': datum.year, 'Domestic claims:': datum.domestic_claims_label, 'Commercial claims:': datum.commercial_claims_label, 'Total claims:': datum.total_claims_label}"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "domesticBars",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "field": "domestic_share_signed"
          },
          "x2": {
            "scale": "xShare",
            "value": 0
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5,
            "offset": {
              "signal": "-rowHeight / 2"
            }
          },
          "height": {
            "signal": "rowHeight"
          },
          "fill": {
            "value": "#f0a33a"
          },
          "cornerRadius": {
            "value": 3
          },
          "cursor": {
            "value": "default"
          }
        },
        "update": {
          "opacity": {
            "signal": "claimTypeHover === 'Commercial' ? 0.18 : (eventHover === null || eventHover === datum.event_name ? 1 : 0.24)"
          },
          "tooltip": {
            "signal": "{'Event:': datum.event_name, 'Year:': datum.year, 'Claim type:': 'Domestic claims', 'Domestic claims:': datum.domestic_claims_label, 'Commercial claims:': datum.commercial_claims_label, 'Domestic share:': datum.domestic_share_label, 'Commercial share:': datum.commercial_share_label, 'Total claims:': datum.total_claims_label, 'Normalised insured loss:': datum.normalised_loss_label}"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "commercialBars",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "value": 0
          },
          "x2": {
            "scale": "xShare",
            "field": "commercial_share_signed"
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5,
            "offset": {
              "signal": "-rowHeight / 2"
            }
          },
          "height": {
            "signal": "rowHeight"
          },
          "fill": {
            "value": "#8f2f21"
          },
          "cornerRadius": {
            "value": 3
          },
          "cursor": {
            "value": "default"
          }
        },
        "update": {
          "opacity": {
            "signal": "claimTypeHover === 'Domestic' ? 0.18 : (eventHover === null || eventHover === datum.event_name ? 1 : 0.24)"
          },
          "tooltip": {
            "signal": "{'Event:': datum.event_name, 'Year:': datum.year, 'Claim type:': 'Commercial claims', 'Domestic claims:': datum.domestic_claims_label, 'Commercial claims:': datum.commercial_claims_label, 'Domestic share:': datum.domestic_share_label, 'Commercial share:': datum.commercial_share_label, 'Total claims:': datum.total_claims_label, 'Normalised insured loss:': datum.normalised_loss_label}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "field": "domestic_share_signed",
            "offset": -7
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 800
          },
          "fill": {
            "value": "#a76412"
          }
        },
        "update": {
          "text": {
            "field": "domestic_share_pct_label"
          },
          "opacity": {
            "signal": "claimTypeHover === 'Commercial' ? 0.18 : (eventHover === null || eventHover === datum.event_name ? 1 : 0.3)"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xShare",
            "field": "commercial_share_signed",
            "offset": 7
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 800
          },
          "fill": {
            "value": "#8f2f21"
          }
        },
        "update": {
          "text": {
            "field": "commercial_share_pct_label"
          },
          "opacity": {
            "signal": "claimTypeHover === 'Domestic' ? 0.18 : (eventHover === null || eventHover === datum.event_name ? 1 : 0.3)"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xClaims",
            "value": 0
          },
          "x2": {
            "scale": "xClaims",
            "field": "total_claims"
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "stroke": {
            "value": "#d5c5b5"
          },
          "strokeWidth": {
            "value": 3
          },
          "strokeCap": {
            "value": "round"
          },
          "cursor": {
            "value": "default"
          }
        },
        "update": {
          "opacity": {
            "signal": "eventHover === null || eventHover === datum.event_name ? 0.9 : 0.22"
          },
          "tooltip": {
            "signal": "{'Event:': datum.event_name, 'Year:': datum.year, 'Total claims:': datum.total_claims_label, 'Domestic claims:': datum.domestic_claims_label, 'Commercial claims:': datum.commercial_claims_label, 'Normalised insured loss:': datum.normalised_loss_label}"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xClaims",
            "field": "total_claims"
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "value": 120
          },
          "fill": {
            "value": "#c0392b"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.6
          },
          "cursor": {
            "value": "default"
          }
        },
        "update": {
          "opacity": {
            "signal": "eventHover === null || eventHover === datum.event_name ? 1 : 0.28"
          },
          "size": {
            "signal": "eventHover === datum.event_name ? 165 : 120"
          },
          "tooltip": {
            "signal": "{'Event:': datum.event_name, 'Year:': datum.year, 'Total claims:': datum.total_claims_label, 'Domestic claims:': datum.domestic_claims_label, 'Commercial claims:': datum.commercial_claims_label, 'Normalised insured loss:': datum.normalised_loss_label}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "claims"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xClaims",
            "field": "total_claims",
            "offset": 10
          },
          "y": {
            "scale": "y",
            "field": "event_name",
            "band": 0.5
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#5a4a42"
          },
          "limit": {
            "value": 92
          }
        },
        "update": {
          "text": {
            "field": "total_claims_text"
          },
          "opacity": {
            "signal": "eventHover === null || eventHover === datum.event_name ? 1 : 0.32"
          }
        }
      }
    }
  ],
  "config": {
    "background": "#FFFDF9"
  }
}
