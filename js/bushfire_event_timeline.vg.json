{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Selected historical timeline of major Australian bushfire events and normalised insured losses with severity tags and card boxes.",
  "width": 1040,
  "height": 455,
  "padding": { "top": 6, "bottom": 18, "left": 38, "right": 38 },
  "autosize": { "type": "fit", "contains": "padding", "resize": true },
  "background": "#ffffff",
  "signals": [
    {
      "name": "hoveredYear",
      "value": null,
      "on": [
        { "events": "@event_hit:mouseover", "update": "datum.year" },
        { "events": "@event_point_hit:mouseover", "update": "datum.year" },
        { "events": "@event_hit:mouseout", "update": "null" },
        { "events": "@event_point_hit:mouseout", "update": "null" }
      ]
    }
  ],
  "data": [
    {
      "name": "events",
      "values": [
        {
          "year": 1967,
          "name": "1967 Bushfire",
          "state": "TAS",
          "lossLabel": "$4.10B",
          "description": "Deadliest bushfire in\nTasmanian history.\nLargest insured loss.",
          "tooltipDescription": "Deadliest bushfire in Tasmanian history. Largest normalised insured loss.",
          "side": "top",
          "severity": "Catastrophic",
          "severityColor": "#c0392b",
          "color": "#c0392b"
        },
        {
          "year": 1969,
          "name": "Lara Bushfire",
          "state": "VIC",
          "lossLabel": "$0.76B",
          "description": "Fast-moving fire near\nLara, Victoria.\nMedium loss severity.",
          "tooltipDescription": "Fast-moving fire near Lara, Victoria. Medium loss severity.",
          "side": "bottom",
          "severity": "High",
          "severityColor": "#e8824a",
          "color": "#e8824a"
        },
        {
          "year": 1983,
          "name": "Ash Wednesday",
          "state": "VIC & SA",
          "lossLabel": "$2.71B",
          "description": "Major fires across\nVictoria and South\nAustralia.",
          "tooltipDescription": "Major fires across Victoria and South Australia.",
          "side": "top",
          "severity": "Catastrophic",
          "severityColor": "#c0392b",
          "color": "#c0392b"
        },
        {
          "year": 1985,
          "name": "Victorian Alpine",
          "state": "VIC",
          "lossLabel": "$1.23B",
          "description": "Large fires swept\nthrough the Victorian\nAlpine region.",
          "tooltipDescription": "Large fires swept through the Victorian Alpine region.",
          "side": "bottom",
          "severity": "High",
          "severityColor": "#e8824a",
          "color": "#e8824a"
        },
        {
          "year": 2003,
          "name": "Canberra Bushfire",
          "state": "ACT",
          "lossLabel": "$1.27B",
          "description": "Fires entered\nCanberra suburbs and\ndestroyed homes.",
          "tooltipDescription": "Fires entered Canberra suburbs and destroyed homes.",
          "side": "top",
          "severity": "High",
          "severityColor": "#e8824a",
          "color": "#e8824a"
        },
        {
          "year": 2009,
          "name": "Black Saturday",
          "state": "VIC",
          "lossLabel": "$2.57B",
          "description": "Australia's deadliest\nbushfire disaster.\n173 lives lost.",
          "tooltipDescription": "Australia's deadliest bushfire disaster. 173 lives lost.",
          "side": "bottom",
          "severity": "Catastrophic",
          "severityColor": "#c0392b",
          "color": "#c0392b"
        },
        {
          "year": 2019,
          "name": "Black Summer",
          "state": "NSW, VIC, QLD, SA",
          "lossLabel": "$2.41B",
          "description": "Unprecedented fires\nfrom late 2019\ninto 2020.",
          "tooltipDescription": "Unprecedented fires from late 2019 into 2020.",
          "side": "top",
          "severity": "Catastrophic",
          "severityColor": "#c0392b",
          "color": "#c0392b"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [1960, 2028],
      "range": "width",
      "zero": false,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": { "value": 0 },
          "x2": { "signal": "width" },
          "y": { "value": 228 },
          "stroke": { "value": "#3f4448" },
          "strokeWidth": { "value": 2.2 },
          "strokeCap": { "value": "round" }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x": { "value": 0 },
          "y": { "value": 228 },
          "shape": { "value": "circle" },
          "size": { "value": 72 },
          "fill": { "value": "#111111" }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": { "signal": "width" },
          "x2": { "signal": "width - 9" },
          "y": { "value": 228 },
          "y2": { "value": 224 },
          "stroke": { "value": "#3f4448" },
          "strokeWidth": { "value": 2.1 },
          "strokeCap": { "value": "round" }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": { "signal": "width" },
          "x2": { "signal": "width - 9" },
          "y": { "value": 228 },
          "y2": { "value": 232 },
          "stroke": { "value": "#3f4448" },
          "strokeWidth": { "value": 2.1 },
          "strokeCap": { "value": "round" }
        }
      }
    },
    {
      "type": "rule",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "value": 228 },
          "y2": { "signal": "datum.side === 'top' ? 145 : 296" },
          "strokeWidth": { "value": 1.25 },
          "strokeCap": { "value": "round" }
        },
        "update": {
          "stroke": { "field": "color" },
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 0.95 : 0.24"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "value": 228 },
          "shape": { "value": "circle" },
          "fill": { "value": "#ffffff" },
          "strokeWidth": { "value": 2.4 }
        },
        "update": {
          "size": { "signal": "hoveredYear === datum.year ? 190 : 142" },
          "stroke": { "field": "color" },
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "name": "card_box",
      "type": "rect",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year", "offset": -88 },
          "y": { "signal": "datum.side === 'top' ? 20 : 296" },
          "width": { "value": 176 },
          "height": { "value": 125 },
          "cornerRadius": { "value": 10 },
          "fill": { "value": "#ffffff" },
          "shadowColor": { "value": "rgba(43, 38, 33, 0.04)" },
          "shadowBlur": { "value": 8 },
          "shadowOffsetX": { "value": 0 },
          "shadowOffsetY": { "value": 2 }
        },
        "update": {
          "stroke": {
            "signal": "hoveredYear === datum.year ? datum.severityColor : 'rgba(43, 38, 33, 0.08)'"
          },
          "strokeWidth": {
            "signal": "hoveredYear === datum.year ? 1.75 : 1"
          },
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "signal": "datum.side === 'top' ? 256 : 200" },
          "text": { "signal": "datum.year + ''" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "font": { "value": "Outfit" },
          "fontSize": { "value": 18 },
          "fontWeight": { "value": 800 }
        },
        "update": {
          "fill": {
            "signal": "hoveredYear === datum.year ? datum.color : 'rgba(43, 38, 33, 0.62)'"
          },
          "opacity": {
            "signal": "hoveredYear === datum.year ? 1.0 : 0.95"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "signal": "datum.side === 'top' ? 32 : 308" },
          "text": { "field": "name" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "font": { "value": "Outfit" },
          "fontSize": { "value": 13.5 },
          "fontWeight": { "value": 800 },
          "fill": { "value": "#2b2621" },
          "limit": { "value": 166 }
        },
        "update": {
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "signal": "datum.side === 'top' ? 52 : 328" },
          "text": { "signal": "datum.lossLabel + '  •  ' + datum.state" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "font": { "value": "Inter" },
          "fontSize": { "value": 10.5 },
          "fontWeight": { "value": 700 },
          "limit": { "value": 166 }
        },
        "update": {
          "fill": { "value": "#5c544d" },
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "signal": "datum.side === 'top' ? 71 : 347" },
          "text": { "signal": "'●  ' + datum.severity" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "font": { "value": "Inter" },
          "fontSize": { "value": 9.5 },
          "fontWeight": { "value": 800 },
          "limit": { "value": 166 }
        },
        "update": {
          "fill": { "field": "severityColor" },
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year", "offset": -68 },
          "x2": { "scale": "x", "field": "year", "offset": 68 },
          "y": { "signal": "datum.side === 'top' ? 86 : 362" },
          "stroke": { "value": "#e2e8f0" },
          "strokeWidth": { "value": 0.75 }
        },
        "update": {
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "signal": "datum.side === 'top' ? 95 : 371" },
          "text": { "field": "description" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "font": { "value": "Inter" },
          "fontSize": { "value": 9.5 },
          "fontWeight": { "value": 500 },
          "fill": { "value": "#5a626a" },
          "lineBreak": { "value": "\n" },
          "lineHeight": { "value": 13 },
          "limit": { "value": 166 }
        },
        "update": {
          "opacity": {
            "signal": "hoveredYear === null || hoveredYear === datum.year ? 1 : 0.36"
          }
        }
      }
    },
    {
      "name": "event_hit",
      "type": "rect",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year", "offset": -88 },
          "y": { "signal": "datum.side === 'top' ? 20 : 296" },
          "width": { "value": 176 },
          "height": { "value": 125 },
          "fill": { "value": "#ffffff" },
          "fillOpacity": { "value": 0.001 },
          "cursor": { "value": "pointer" },
          "tooltip": {
            "signal": "{'Event': datum.name, 'Year': datum.year, 'Normalised insured loss': datum.lossLabel, 'State': datum.state, 'Severity': datum.severity, 'Description': datum.tooltipDescription}"
          }
        }
      }
    },
    {
      "name": "event_point_hit",
      "type": "symbol",
      "from": { "data": "events" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "year" },
          "y": { "value": 228 },
          "shape": { "value": "circle" },
          "size": { "value": 760 },
          "fill": { "value": "#ffffff" },
          "fillOpacity": { "value": 0.001 },
          "strokeOpacity": { "value": 0 },
          "cursor": { "value": "pointer" },
          "tooltip": {
            "signal": "{'Event': datum.name, 'Year': datum.year, 'Normalised insured loss': datum.lossLabel, 'State': datum.state, 'Severity': datum.severity, 'Description': datum.tooltipDescription}"
          }
        }
      }
    }
  ]
}
