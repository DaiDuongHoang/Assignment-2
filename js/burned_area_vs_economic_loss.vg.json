{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "FIG. 3D · BURNED AREA VS ECONOMIC LOSS. Bubble scatter testing whether larger burned area means greater insured loss.",
  "width": "container",
  "height": 440,
  "background": "transparent",
  "padding": {"top": 20, "right": 36, "bottom": 10, "left": 10},
  "data": {
    "url": "data/bushfire_event_burned_area_loss.csv",
    "format": {
      "type": "csv",
      "parse": {
        "event_year": "number",
        "burned_area_ha": "number",
        "normalised_insured_loss_2022_aud": "number",
        "claims_count": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.normalised_insured_loss_2022_aud / 1000000000",
      "as": "loss_billions"
    },
    {
      "calculate": "isValid(datum.claims_count) && datum.claims_count > 0 ? datum.claims_count : 1500",
      "as": "claims_for_size"
    },
    {
      "calculate": "isValid(datum.claims_count) && datum.claims_count > 0 ? format(datum.claims_count, ',') : 'No claims data'",
      "as": "claims_label"
    },
    {
      "calculate": "indexof(['Black Summer','Black Saturday','Ash Wednesday','1967 Bushfire'], datum.event_name) >= 0",
      "as": "is_key_event"
    },
    {
      "calculate": "datum.burned_area_ha >= 1000000 ? format(datum.burned_area_ha / 1000000, '.1f') + 'M ha' : format(datum.burned_area_ha / 1000, '.0f') + 'k ha'",
      "as": "burned_area_label"
    }
  ],
  "params": [
    {
      "name": "confidence_filter",
      "value": "All matched events",
      "bind": {
        "input": "select",
        "options": ["All matched events", "High confidence only"],
        "name": "Show: "
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "burned_area_ha",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [1000, 40000000], "nice": false},
      "axis": {
        "title": "Burned area (ha, log scale)",
        "titleColor": "#5F6B7A",
        "titleFontSize": 12,
        "titleFont": "Inter, sans-serif",
        "titleFontWeight": 600,
        "titlePadding": 12,
        "grid": true,
        "gridColor": "#EDE7DF",
        "gridDash": [2, 4],
        "labelColor": "#5F6B7A",
        "labelFontSize": 11,
        "labelFont": "Inter, sans-serif",
        "values": [1000, 10000, 100000, 1000000, 10000000],
        "labelExpr": "datum.value >= 1000000 ? (datum.value / 1000000) + 'M' : datum.value >= 1000 ? (datum.value / 1000) + 'k' : datum.value"
      }
    },
    "y": {
      "field": "loss_billions",
      "type": "quantitative",
      "scale": {"domain": [0, 3.2]},
      "axis": {
        "title": "Normalised insured loss (Billion AUD, 2022)",
        "titleColor": "#5F6B7A",
        "titleFontSize": 12,
        "titleFont": "Inter, sans-serif",
        "titleFontWeight": 600,
        "titlePadding": 14,
        "grid": true,
        "gridColor": "#EDE7DF",
        "gridDash": [2, 4],
        "labelColor": "#5F6B7A",
        "labelFontSize": 11,
        "labelFont": "Inter, sans-serif",
        "format": "$.1f",
        "tickCount": 6
      }
    }
  },
  "layer": [
    {
      "name": "bubbles",
      "transform": [
        {"filter": "confidence_filter === 'All matched events' || datum.matching_confidence === 'High'"}
      ],
      "params": [
        {
          "name": "hover_point",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout", "fields": ["event_name"]}
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FFFDF9",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "size": {
          "field": "claims_for_size",
          "type": "quantitative",
          "scale": {"domain": [0, 40000], "range": [150, 1400]},
          "legend": null
        },
        "color": {
          "field": "matching_confidence",
          "type": "nominal",
          "scale": {
            "domain": ["High", "Medium"],
            "range": ["#B5202B", "#E8A33D"]
          },
          "legend": null
        },
        "opacity": {
          "condition": {"param": "hover_point", "value": 1},
          "value": 0.82
        },
        "tooltip": [
          {"field": "event_name", "type": "nominal", "title": "Event"},
          {"field": "event_period", "type": "nominal", "title": "Period"},
          {"field": "burned_area_ha", "type": "quantitative", "title": "Burned area (ha)", "format": ",.0f"},
          {"field": "normalised_insured_loss_2022_aud", "type": "quantitative", "title": "Insured loss (2022 AUD)", "format": "$,.0f"},
          {"field": "claims_label", "type": "nominal", "title": "Claims"},
          {"field": "matching_confidence", "type": "nominal", "title": "Match confidence"},
          {"field": "notes", "type": "nominal", "title": "Notes"}
        ]
      }
    },
    {
      "name": "key_event_labels",
      "transform": [
        {"filter": "confidence_filter === 'All matched events' || datum.matching_confidence === 'High'"},
        {"filter": "datum.is_key_event"}
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -16,
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Inter, sans-serif",
        "fill": "#2B2621"
      },
      "encoding": {
        "text": {"field": "event_name", "type": "nominal"},
        "opacity": {"value": 0.92}
      }
    }
  ]
}
