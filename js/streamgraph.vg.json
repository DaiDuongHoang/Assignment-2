{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/australian_annual_bushfire_area_(19902020).csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "legendFilter",
          "select": {
            "type": "point",
            "fields": ["Fire Type"]
          },
          "bind": "legend"
        },
        {
          "name": "areaFilter",
          "select": {
            "type": "point",
            "fields": ["Fire Type"],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "transform": [
        {
          "fold": [
            "Tropical_savanna_woodlands",
            "Arid_semi_arid_rangelands",
            "Temperate_forest_wildfires",
            "Temperate_forest_hazard_reduction"
          ],
          "as": ["Category", "Area"]
        },
        {
          "calculate": "toNumber(datum.Area)",
          "as": "Area"
        },
        {
          "calculate": "toNumber(datum.Year)",
          "as": "Year"
        },
        {
          "calculate": "datum.Category === 'Tropical_savanna_woodlands' ? 'Tropical Savanna Woodlands' : datum.Category === 'Arid_semi_arid_rangelands' ? 'Arid & Semi-Arid Rangelands' : datum.Category === 'Temperate_forest_wildfires' ? 'Temperate Forest Wildfires' : 'Hazard Reduction Burns'",
          "as": "Fire Type"
        },
        {
          "calculate": "datum.Category === 'Temperate_forest_hazard_reduction' ? 1 : datum.Category === 'Temperate_forest_wildfires' ? 2 : datum.Category === 'Arid_semi_arid_rangelands' ? 3 : 4",
          "as": "stackOrder"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "line": {
          "color": "white",
          "strokeWidth": 0.8
        },
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "grid": false,
            "tickCount": 8,
            "labelFont": "Inter",
            "labelFontSize": 11,
            "labelColor": "#555",
            "domainColor": "#bbb"
          }
        },
        "y": {
          "field": "Area",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "Fire Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Tropical Savanna Woodlands",
              "Arid & Semi-Arid Rangelands",
              "Temperate Forest Wildfires",
              "Hazard Reduction Burns"
            ],
            "range": ["#388e3c", "#8d6e63", "#c62828", "#ff8f00"]
          },
          "legend": null
        },
        "order": {
          "field": "stackOrder",
          "type": "quantitative"
        },
        "opacity": {
          "condition": [
            {
              "test": "!length(data('legendFilter_store')) && !length(data('areaFilter_store'))",
              "value": 0.92
            },
            {
              "param": "legendFilter",
              "empty": false,
              "value": 0.92
            },
            {
              "param": "areaFilter",
              "empty": false,
              "value": 0.92
            }
          ],
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Fire Type",
            "type": "nominal",
            "title": "Vegetation Type"
          },
          {
            "field": "Area",
            "type": "quantitative",
            "title": "Area (M ha)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2015
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 1.5,
        "opacity": 0.25
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "color": {
          "value": "#000000"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2019
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 1.5,
        "opacity": 0.25
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "color": {
          "value": "#000000"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 1993,
            "Year2": 1993,
            "StartY": 37,
            "EndY": 4,
            "label": "Tropical Savanna",
            "Fire Type": "Tropical Savanna Woodlands"
          },
          {
            "Year": 1999,
            "Year2": 1999,
            "StartY": 25,
            "EndY": -2,
            "label": "Rangelands",
            "Fire Type": "Arid & Semi-Arid Rangelands"
          },
          {
            "Year": 2005,
            "Year2": 2005,
            "StartY": 12,
            "EndY": -8,
            "label": "Wildfires",
            "Fire Type": "Temperate Forest Wildfires"
          },
          {
            "Year": 2011,
            "Year2": 2011,
            "StartY": 4.5,
            "EndY": -11,
            "label": "Hazard burns",
            "Fire Type": "Hazard Reduction Burns"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 1.8,
            "opacity": 0.95,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative"
            },
            "y": {
              "field": "StartY",
              "type": "quantitative"
            },
            "x2": {
              "field": "Year2"
            },
            "y2": {
              "field": "EndY"
            },
            "color": {
              "field": "Fire Type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Tropical Savanna Woodlands",
                  "Arid & Semi-Arid Rangelands",
                  "Temperate Forest Wildfires",
                  "Hazard Reduction Burns"
                ],
                "range": ["#388e3c", "#8d6e63", "#c62828", "#ff8f00"]
              },
              "legend": null
            },
            "opacity": {
              "condition": [
                {
                  "test": "!length(data('legendFilter_store')) && !length(data('areaFilter_store'))",
                  "value": 1
                },
                {
                  "param": "legendFilter",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "areaFilter",
                  "empty": false,
                  "value": 1
                }
              ],
              "value": 0.2
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "font": "Inter",
            "fontSize": 13.5,
            "fontWeight": 700,
            "align": "center",
            "baseline": "top",
            "dy": 6,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "Year2",
              "type": "quantitative"
            },
            "y": {
              "field": "EndY",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "color": {
              "field": "Fire Type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Tropical Savanna Woodlands",
                  "Arid & Semi-Arid Rangelands",
                  "Temperate Forest Wildfires",
                  "Hazard Reduction Burns"
                ],
                "range": ["#388e3c", "#4e342e", "#c62828", "#ff8f00"]
              },
              "legend": null
            },
            "opacity": {
              "condition": [
                {
                  "test": "!length(data('legendFilter_store')) && !length(data('areaFilter_store'))",
                  "value": 1
                },
                {
                  "param": "legendFilter",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "areaFilter",
                  "empty": false,
                  "value": 1
                }
              ],
              "value": 0.2
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "Year": 2015,
            "label": "2015 total: 60M ha"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 13.5,
        "fontWeight": 700,
        "align": "right",
        "baseline": "bottom",
        "dy": 140,
        "dx": -10,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "y": {
          "value": 18
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2019,
            "label": "Black Summer"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 13.5,
        "fontWeight": 700,
        "align": "right",
        "baseline": "bottom",
        "dy": 140,
        "dx": -10,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "y": {
          "value": 18
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "title": {
      "font": "Outfit",
      "subtitleFont": "Inter"
    }
  }
}
