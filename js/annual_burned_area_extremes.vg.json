{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "FIG. 1B · BLACK SUMMER SHIFT BY STATE. Diverging horizontal change lollipop / dumbbell hybrid chart.",
  "width": "container",
  "height": 280,
  "background": "#FFFDF9",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {"top": 10, "right": 65, "bottom": 10, "left": 35},
  "params": [
    {
      "name": "displayMode",
      "value": "Change from baseline",
      "bind": {
        "input": "select",
        "options": ["Change from baseline", "Before vs Black Summer"],
        "name": "Display Mode:"
      }
    }
  ],
  "data": {
    "url": "data/black_summer_shift_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "baseline_avg_burned_cells": "number",
        "black_summer_burned_cells": "number",
        "absolute_change": "number",
        "percent_change": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "displayMode === 'Change from baseline' ? datum.absolute_change : datum.black_summer_burned_cells",
      "as": "current_x"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? 0 : datum.baseline_avg_burned_cells",
      "as": "current_line_start"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? (datum.absolute_change > 0 ? '#B83246' : '#8E8276') : '#B83246'",
      "as": "dot_color"
    },
    {
      "calculate": "datum.absolute_change > 0 ? '#C97D84' : '#C4BBB4'",
      "as": "line_color"
    },
    {
      "calculate": "datum.absolute_change > 1000000 || datum.absolute_change < -500000 ? 3.5 : 2",
      "as": "line_stroke"
    },
    {
      "calculate": "datum.absolute_change > 400000 ? '+' + format(datum.absolute_change / 1000000, '.1f') + 'M' : (datum.absolute_change < -500000 ? '-' + format(abs(datum.absolute_change) / 1000000, '.1f') + 'M' : '')",
      "as": "change_label"
    },
    {
      "calculate": "format(datum.baseline_avg_burned_cells, ',.0f') + ' burned cells'",
      "as": "tooltip_baseline"
    },
    {
      "calculate": "format(datum.black_summer_burned_cells, ',.0f') + ' burned cells'",
      "as": "tooltip_black_summer"
    },
    {
      "calculate": "(datum.absolute_change > 0 ? '+' : '-') + format(abs(datum.absolute_change), ',.0f') + ' burned cells'",
      "as": "tooltip_abs_change"
    },
    {
      "calculate": "(datum.percent_change > 0 ? '+' : '') + format(datum.percent_change, '.1f') + '%'",
      "as": "tooltip_pct_change"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? 0 : 0.7",
      "as": "baseline_opacity_default"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? 0 : 1.0",
      "as": "baseline_opacity_hover"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? 0.3 : 0",
      "as": "neg_label_opacity_default"
    },
    {
      "calculate": "displayMode === 'Change from baseline' ? 1.0 : 0",
      "as": "neg_label_opacity_hover"
    }
  ],
  "encoding": {
    "y": {
      "field": "state_name",
      "type": "nominal",
      "sort": {"field": "absolute_change", "order": "descending"},
      "axis": {
        "domainColor": "rgba(43, 38, 33, 0.25)",
        "tickColor": "rgba(43, 38, 33, 0.20)",
        "labelColor": "#2C2520",
        "labelFont": "Inter, sans-serif",
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "title": null,
        "offset": 10,
        "minExtent": 190
      }
    },
    "x": {
      "type": "quantitative",
      "scale": {
        "domain": [-1500000, 8000000]
      },
      "axis": {
        "title": {"signal": "displayMode === 'Change from baseline' ? 'Change in Burned Cells from Pre-Black Summer Average' : 'Burned Cell Totals'"},
        "grid": true,
        "gridColor": "rgba(43, 38, 33, 0.08)",
        "gridWidth": 1,
        "domainColor": "rgba(43, 38, 33, 0.25)",
        "tickColor": "rgba(43, 38, 33, 0.20)",
        "labelColor": "#5F6B7A",
        "labelFont": "Inter, sans-serif",
        "labelFontSize": 11,
        "titleColor": "#334155",
        "titleFont": "Inter, sans-serif",
        "titleFontSize": 12,
        "titleFontWeight": 700,
        "titlePadding": 10,
        "labelExpr": "abs(datum.value) >= 1000000 ? (datum.value / 1000000) + 'M' : abs(datum.value) >= 1000 ? (datum.value / 1000) + 'k' : datum.value"
      }
    }
  },
  "layer": [
    {
      "name": "zero_line",
      "mark": {
        "type": "rule",
        "color": "rgba(43, 38, 33, 0.4)",
        "strokeWidth": 1.5,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "x": {"datum": 0},
        "opacity": {
          "signal": "displayMode === 'Change from baseline' ? 1.0 : 0"
        }
      }
    },
    {
      "name": "connecting_lines",
      "mark": {"type": "rule", "cap": "round"},
      "encoding": {
        "x": {"field": "current_line_start", "type": "quantitative"},
        "x2": {"field": "current_x", "type": "quantitative"},
        "color": {
          "field": "line_color",
          "type": "nominal",
          "scale": null
        },
        "strokeWidth": {
          "field": "line_stroke",
          "type": "quantitative",
          "scale": null
        },
        "opacity": {
          "condition": {
            "param": "hoverState",
            "value": 0.85
          },
          "value": 0.3
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State / Territory:"},
          {"field": "tooltip_baseline", "type": "nominal", "title": "Pre-Black Summer average:"},
          {"field": "tooltip_black_summer", "type": "nominal", "title": "2019–20 Black Summer:"},
          {"field": "tooltip_abs_change", "type": "nominal", "title": "Absolute change:"},
          {"field": "tooltip_pct_change", "type": "nominal", "title": "Percent change:"}
        ]
      }
    },
    {
      "name": "black_summer_dots",
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "fields": ["state_name"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 100,
        "stroke": "#FFFDF9",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {"field": "current_x"},
        "color": {
          "field": "dot_color",
          "type": "nominal",
          "scale": null
        },
        "opacity": {
          "condition": {
            "param": "hoverState",
            "value": 1.0
          },
          "value": 0.9
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State / Territory:"},
          {"field": "tooltip_baseline", "type": "nominal", "title": "Pre-Black Summer average:"},
          {"field": "tooltip_black_summer", "type": "nominal", "title": "2019–20 Black Summer:"},
          {"field": "tooltip_abs_change", "type": "nominal", "title": "Absolute change:"},
          {"field": "tooltip_pct_change", "type": "nominal", "title": "Percent change:"}
        ]
      }
    },
    {
      "name": "baseline_dots",
      "mark": {
        "type": "circle",
        "size": 80,
        "color": "#8E8276",
        "stroke": "#FFFDF9",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {"field": "baseline_avg_burned_cells", "type": "quantitative"},
        "opacity": {
          "condition": {
            "param": "hoverState",
            "field": "baseline_opacity_hover",
            "type": "quantitative",
            "scale": null
          },
          "field": "baseline_opacity_default",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State / Territory:"},
          {"field": "tooltip_baseline", "type": "nominal", "title": "Pre-Black Summer average:"},
          {"field": "tooltip_black_summer", "type": "nominal", "title": "2019–20 Black Summer:"},
          {"field": "tooltip_abs_change", "type": "nominal", "title": "Absolute change:"},
          {"field": "tooltip_pct_change", "type": "nominal", "title": "Percent change:"}
        ]
      }
    },
    {
      "name": "direct_labels_positive",
      "transform": [
        {
          "filter": "datum.absolute_change > 0"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontWeight": 700,
        "fontSize": 11,
        "font": "Inter, sans-serif",
        "align": "left",
        "dx": 10
      },
      "encoding": {
        "x": {"field": "current_x"},
        "text": {"field": "change_label", "type": "nominal"},
        "color": {
          "field": "dot_color",
          "type": "nominal",
          "scale": null
        },
        "opacity": {
          "condition": {
            "param": "hoverState",
            "value": 1.0
          },
          "value": 0.3
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State / Territory:"},
          {"field": "tooltip_baseline", "type": "nominal", "title": "Pre-Black Summer average:"},
          {"field": "tooltip_black_summer", "type": "nominal", "title": "2019–20 Black Summer:"},
          {"field": "tooltip_abs_change", "type": "nominal", "title": "Absolute change:"},
          {"field": "tooltip_pct_change", "type": "nominal", "title": "Percent change:"}
        ]
      }
    },
    {
      "name": "direct_labels_negative",
      "transform": [
        {
          "filter": "datum.absolute_change < 0"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontWeight": 700,
        "fontSize": 11,
        "font": "Inter, sans-serif",
        "align": "right",
        "dx": -10
      },
      "encoding": {
        "x": {"field": "current_x"},
        "text": {"field": "change_label", "type": "nominal"},
        "color": {
          "field": "dot_color",
          "type": "nominal",
          "scale": null
        },
        "opacity": {
          "condition": {
            "param": "hoverState",
            "field": "neg_label_opacity_hover",
            "type": "quantitative",
            "scale": null
          },
          "field": "neg_label_opacity_default",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State / Territory:"},
          {"field": "tooltip_baseline", "type": "nominal", "title": "Pre-Black Summer average:"},
          {"field": "tooltip_black_summer", "type": "nominal", "title": "2019–20 Black Summer:"},
          {"field": "tooltip_abs_change", "type": "nominal", "title": "Absolute change:"},
          {"field": "tooltip_pct_change", "type": "nominal", "title": "Percent change:"}
        ]
      }
    }
  ]
}
